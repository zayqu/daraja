generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(JOB_SEEKER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employer   Employer?
  freelancer Freelancer?
  jobSeeker  JobSeeker?
  accounts   Account[]
  sessions   Session[]
  jobAlerts  JobAlertSubscriber[]
  savedJobs  SavedJob[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  JOB_SEEKER
  EMPLOYER
  FREELANCER
  ADMIN
}

model Employer {
  id          String   @id @default(cuid())
  userId      String   @unique
  companyName String
  industry    String?
  website     String?
  logo        String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User  @relation(fields: [userId], references: [id])
  jobs Job[]
}

model JobSeeker {
  id              String   @id @default(cuid())
  userId          String   @unique
  fullName        String
  phone           String?
  cvUrl           String?
  headline        String?
  location        String?
  experienceLevel String?
  workArrangement String?
  portfolioUrl    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id])
  applications Application[]
  documents    CandidateDocument[]
}

model CandidateDocument {
  id          String                @id @default(cuid())
  jobSeekerId String
  name        String
  kind        CandidateDocumentKind
  url         String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  jobSeeker JobSeeker @relation(fields: [jobSeekerId], references: [id], onDelete: Cascade)

  @@index([jobSeekerId, createdAt])
}

enum CandidateDocumentKind {
  CV
  COVER_LETTER
  CERTIFICATE
  PORTFOLIO
  OTHER
}

model Freelancer {
  id        String   @id @default(cuid())
  userId    String   @unique
  fullName  String
  skills    String[]
  bio       String?
  portfolio String?
  phone     String?
  available Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Job {
  id          String    @id @default(cuid())
  slug        String    @unique
  sourceId    String?
  title       String
  company     String
  location    String
  description String
  category    String
  type        JobType   @default(FULL_TIME)
  salary      String?
  deadline    DateTime?
  sourceUrl   String?
  source      String    @default("daraja")
  language    String    @default("en")
  featured    Boolean   @default(false)
  active      Boolean   @default(true)
  employerId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employer     Employer?     @relation(fields: [employerId], references: [id])
  applications Application[]
  savedBy      SavedJob[]

  @@unique([source, sourceId])
  @@index([source, active, deadline])
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

model Application {
  id             String    @id @default(cuid())
  jobId          String
  jobSeekerId    String
  coverLetter    String?
  applicationKey String?   @unique
  status         AppStatus @default(PENDING)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  job       Job       @relation(fields: [jobId], references: [id])
  jobSeeker JobSeeker @relation(fields: [jobSeekerId], references: [id])

  @@index([jobSeekerId, createdAt])
  @@index([jobId, status])
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, createdAt])
}

enum AppStatus {
  PENDING
  REVIEWED
  SHORTLISTED
  OFFERED
  REJECTED
  WITHDRAWN
}

model Subscription {
  id        String    @id @default(cuid())
  userId    String
  plan      Plan
  status    SubStatus @default(ACTIVE)
  startDate DateTime  @default(now())
  endDate   DateTime
  createdAt DateTime  @default(now())
}

enum Plan {
  EMPLOYER_BASIC
  EMPLOYER_PRO
  FREELANCER
  JOB_SEEKER_PREMIUM
}

enum SubStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model Payment {
  id        String    @id @default(cuid())
  userId    String
  amount    Float
  currency  String    @default("TZS")
  reference String    @unique
  status    PayStatus @default(PENDING)
  provider  String    @default("selcom")
  createdAt DateTime  @default(now())
}

model JobAlertSubscriber {
  id               String   @id @default(cuid())
  userId           String?  @unique
  email            String   @unique
  unsubscribeToken String   @unique @default(uuid())
  categories       String[] @default([])
  locations        String[] @default([])
  experienceLevels String[] @default([])
  workArrangements String[] @default([])
  organisations    String[] @default([])
  keywords         String[] @default([])
  interests        String[] @default([])
  active           Boolean  @default(true)
  consentedAt      DateTime
  lastNotifiedAt   DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user       User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries JobAlertDelivery[]

  @@index([active, lastNotifiedAt])
}

model JobAlertDelivery {
  id                String              @id @default(cuid())
  subscriberId      String
  deduplicationKey  String              @unique
  status            AlertDeliveryStatus @default(PENDING)
  jobIds            String[]
  attemptCount      Int                 @default(0)
  nextAttemptAt     DateTime?
  providerMessageId String?
  lastError         String?
  sentAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  subscriber JobAlertSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([subscriberId, createdAt])
}

enum AlertDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum PayStatus {
  PENDING
  SUCCESS
  FAILED
}
