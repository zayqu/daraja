# Apple Sign In — server-side setup only
# This is a reference template, NOT a deployable credentials file.
# Do not place real credentials in GitHub or send them in chat.
# See docs/APPLE_SIGN_IN_SETUP.md for Apple Developer configuration.
#
# Apple requires an existing Sign in with Apple App ID, associated Services ID
# and the exact HTTPS callback: https://ajira.daraja.co.tz/api/auth/callback/apple
#
# Set these values ONLY through the host's protected environment settings.
# AUTH_APPLE_ID is a web Services ID, NOT an iOS bundle ID.
# AUTH_APPLE_SECRET is an ES256-signed client-secret JWT, NOT the .p8 private key.
# The JWT expires and must be safely rotated before that date.
#
# Leave disabled until Apple Developer setup and real sign-in verification.
AUTH_APPLE_ENABLED=false
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
#
# Existing sign-in providers stay in place:
# AUTH_GOOGLE_ID and AUTH_GOOGLE_SECRET
# AUTH_LINKEDIN_ID and AUTH_LINKEDIN_SECRET
# Email/password uses the existing Daraja account API.
#
# AUTH_URL must match the deployment's actual HTTPS origin when checking
# the Apple web return address (e.g., https://ajira.daraja.co.tz).
# Do not copy example values into production without verifying the host.
